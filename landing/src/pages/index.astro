---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../layouts/Layout.astro';

const APP_URL = 'https://mosstask.vercel.app';

// Optional screenshots: drop home.webp, tasks.webp or tools.webp into /public
// and they are picked up automatically. Until then the page uses the
// screenshots that already exist (project, collab, calendar).
const has = (f: string) => existsSync(join(process.cwd(), 'public', f));

const shots = {
  hero: { src: '/project.webp', w: 1600, h: 900, alt: 'MossTask showing a project with tasks, due dates, and a completion progress bar.' },
  home: has('home.webp')
    ? { src: '/home.webp', w: 1600, h: 900, alt: 'MossTask Home with today\'s tasks, active tasks, the week ahead, and a completion streak.' }
    : null,
  tasks: has('tasks.webp')
    ? { src: '/tasks.webp', w: 1600, h: 900, alt: 'A MossTask task with priority, due date, subtasks, and progress.' }
    : null,
  projects: { src: '/collab.webp', w: 1200, h: 700, alt: 'A shared MossTask project with its tasks and members.' },
  rhythm: has('tools.webp')
    ? { src: '/tools.webp', w: 238, h: 900, alt: 'MossTask calendar, notes, and Pomodoro timer.' }
    : { src: '/calendar.webp', w: 1400, h: 1000, alt: 'MossTask calendar month view with events on different days.' },
};

const overview = [
  { title: 'Tasks', desc: 'Priorities, due dates, subtasks.', icon: 'check-square' },
  { title: 'Projects', desc: 'Tasks, announcements, progress.', icon: 'folder' },
  { title: 'Calendar', desc: 'Events and due dates together.', icon: 'calendar' },
  { title: 'Notes', desc: 'Context next to the work.', icon: 'file-text' },
  { title: 'Focus', desc: 'Pomodoro from any task.', icon: 'timer' },
  { title: 'Overview', desc: 'Today, this week, your streak.', icon: 'trending-up' },
];

const workflow = [
  { n: '01', title: 'Plan', desc: 'Know what needs doing.' },
  { n: '02', title: 'Organize', desc: 'Keep work in the right place.' },
  { n: '03', title: 'Focus', desc: 'Stay with the task.' },
  { n: '04', title: 'Finish', desc: 'Close things out and move on.' },
];

const categories = [
  {
    id: 'tasks',
    label: 'Get things done',
    title: 'Keep the next thing obvious.',
    desc: 'Tasks stay focused on what matters: what needs doing, when it matters, and how far along it is.',
    points: [
      'Priorities and due dates',
      'Subtasks with a progress bar',
      'Pin the tasks that matter most',
      'Repeating tasks: daily, weekly, or monthly',
    ],
    shot: shots.tasks,
  },
  {
    id: 'projects',
    label: 'Keep work together',
    title: 'Keep the whole project in view.',
    desc: 'Personal is your own space for everyday work and stays yours. Projects keep shared work, tasks, announcements, and progress together.',
    defs: [
      { term: 'Description', text: 'What the project is.' },
      { term: 'Announcement', text: 'What needs attention now.' },
    ],
    points: [
      'Members work from the same project',
      'Project owners can assign tasks',
      'Roles for members on the Team plan',
    ],
    shot: shots.projects,
  },
  {
    id: 'rhythm',
    label: 'Stay in rhythm',
    title: 'Work the way your day actually moves.',
    desc: 'See what is coming, keep useful context nearby, and start a focused session without leaving your workspace.',
    points: [
      'Calendar with events and task due dates',
      'Notes with your own categories',
      'Pomodoro from any task, with time tracked per task',
      'Reminders and a daily closeout for what is unfinished',
    ],
    shot: shots.rhythm,
  },
];

const plans = [
  {
    name: 'Free',
    price: '$0',
    period: 'No card needed',
    cta: 'Get started',
    primary: true,
    features: [
      'Unlimited personal projects, tasks, notes, and calendar',
      'Use it without an account; your data stays on your device',
      'Sync across devices with an account',
      '3 collaborative projects',
      'Up to 6 people per project',
    ],
  },
  {
    name: 'Team',
    price: '$5',
    period: 'per month',
    cta: 'Get started',
    primary: false,
    note: 'Sign in, then upgrade from Settings.',
    features: [
      'Everything in Free',
      '10 collaborative projects',
      'Up to 20 people per project',
      'Roles and task assignment',
      'Server-delivered reminders',
    ],
  },
];

// Minimal inline icon set, stroke-based to match the app's own icon
// style — no icon package or external font needed.
const icons: Record<string, string> = {
  'check-square': '<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>',
  folder: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/>',
  users: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
  timer: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5M9 2h6"/>',
  lock: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  zap: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>',
  'plus-circle': '<circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/>',
  cloud: '<path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/>',
  check: '<path d="M20 6L9 17l-5-5"/>',
  x: '<path d="M18 6L6 18M6 6l12 12"/>',
  globe: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
  monitor: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
  apple: '<path d="M12 20.94c1.5 0 2.75-.34 3.75-1 1.5-1 2.25-2.44 2.25-4.31 0-1.13-.25-2.13-.75-3-1.5-2.5-3.5-4.13-6-4.13-2.5 0-5 1.5-6 4-.25.75-.25 1.5-.25 2.25 0 2.13 1.25 4.5 3 5.63 1.13.75 2.25 1.06 3.5 1.06z"/><path d="M9.5 6.5c0-2 1.5-3.5 3.5-3.5s3.5 1.5 3.5 3.5"/>',
  terminal: '<polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>',
  'arrow-right': '<line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>',
  sparkles: '<path d="M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5L12 3z"/><path d="M19 15l.75 2.25L22 18l-2.25.75L19 21l-.75-2.25L16 18l2.25-.75L19 15z"/><path d="M5 15l.75 2.25L8 18l-2.25.75L5 21l-.75-2.25L2 18l2.25-.75L5 15z"/>',
  feather: '<path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/><line x1="16" y1="8" x2="2" y2="22"/><line x1="17.5" y1="15" x2="9" y2="15"/>',
  'hard-drive': '<line x1="22" y1="12" x2="2" y2="12"/><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/><line x1="6" y1="16" x2="6.01" y2="16"/><line x1="10" y1="16" x2="10.01" y2="16"/>',
  unlock: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/>',
  'file-text': '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>',
  bell: '<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>',
  'message-circle': '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>',
  moon: '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>',
  'trending-up': '<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
};

function icon(name: string) {
  return icons[name] ?? '';
}
---

<Layout heroImage={shots.hero.src}>
  <a href="#main" class="skip-link">Skip to content</a>
  <header class="nav">
    <div class="container nav-inner">
      <a href="/" class="brand">
        <img src="/favicon.png" alt="" width="26" height="26" />
        <span class="display">MossTask</span>
      </a>

      <nav class="nav-links" aria-label="Primary">
        <a href="#features">Features</a>
        <a href="#pricing">Pricing</a>
      </nav>

      <div class="nav-actions">
        <div class="theme-toggle" role="group" aria-label="Theme">
          <button type="button" class="theme-toggle-btn" data-theme="light" aria-label="Light theme">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
          </button>
          <button type="button" class="theme-toggle-btn" data-theme="dark" aria-label="Dark theme">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
          </button>
        </div>
        <a href={APP_URL} class="btn ghost desktop-only">Sign in</a>
        <a href={APP_URL} class="btn primary desktop-only">Get started</a>
        <button type="button" class="menu-toggle" id="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
      </div>
    </div>

    <div class="mobile-menu" id="mobile-menu">
      <a href="#features">Features</a>
      <a href="#pricing">Pricing</a>
      <div class="mobile-menu-actions">
        <a href={APP_URL} class="btn ghost">Sign in</a>
        <a href={APP_URL} class="btn primary">Get started</a>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="hero">
      <div class="container hero-inner">
        <div class="hero-copy">
          <span class="eyebrow">MossTask</span>
          <h1 class="display">Calm workflow. Work fast.</h1>
          <p class="hero-sub">
            Tasks, projects, notes, calendar, and focus tools, organized without
            turning your workflow into another thing to manage.
          </p>
          <div class="hero-actions">
            <a href={APP_URL} class="btn primary">
              Get started
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <a href="#overview" class="btn ghost">Explore MossTask</a>
          </div>
          <ul class="hero-points">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>No signup wall</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>Your data stays on your device</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>Free to start</li>
          </ul>
        </div>

        <div class="hero-visual">
          <img
            src={shots.hero.src}
            alt={shots.hero.alt}
            width={shots.hero.w}
            height={shots.hero.h}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="shot"
          />
        </div>
      </div>
    </section>

    <section id="overview" class="overview" aria-labelledby="overview-title">
      <div class="container">
        <div class="section-head centered">
          <h2 id="overview-title" class="display">Everything stays close to the work.</h2>
          <p class="section-sub">
            Tasks, projects, notes, calendar, and focus tools share the same
            workspace, so you can move from planning to doing without jumping
            between systems.
          </p>
        </div>
        {shots.home && (
          <img
            src={shots.home.src}
            alt={shots.home.alt}
            width={shots.home.w}
            height={shots.home.h}
            loading="lazy"
            decoding="async"
            class="shot overview-shot"
          />
        )}
        <ul class="overview-grid">
          {overview.map((o) => (
            <li class="overview-item">
              <span class="overview-icon" aria-hidden="true" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">${icon(o.icon)}</svg>`} />
              <h3>{o.title}</h3>
              <p>{o.desc}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="how" class="how" aria-labelledby="how-title">
      <div class="container">
        <div class="section-head">
          <h2 id="how-title" class="display">Open it. See what's next. Get to work.</h2>
        </div>
        <ol class="steps">
          {workflow.map((s) => (
            <li class="step">
              <span class="step-num display" aria-hidden="true">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="features" class="features" aria-labelledby="features-title">
      <div class="container">
        <h2 id="features-title" class="visually-hidden">Features</h2>
        {categories.map((c, i) => (
          <article class={`feature-row${i % 2 === 1 ? ' reverse' : ''}${c.shot ? '' : ' solo'}`} id={c.id}>
            <div class="feature-copy">
              <span class="eyebrow">{c.label}</span>
              <h3 class="display">{c.title}</h3>
              <p>{c.desc}</p>
              {c.defs && (
                <dl class="defs">
                  {c.defs.map((d) => (
                    <div>
                      <dt>{d.term}</dt>
                      <dd>{d.text}</dd>
                    </div>
                  ))}
                </dl>
              )}
              <ul class="feature-points">
                {c.points.map((p) => (
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </div>
            {c.shot && (
              <div class={`feature-visual${c.id === 'rhythm' ? ' tools-visual' : ''}`}>
                <img
                  src={c.shot.src}
                  alt={c.shot.alt}
                  width={c.shot.w}
                  height={c.shot.h}
                  loading="lazy"
                  decoding="async"
                  class="shot"
                />
              </div>
            )}
          </article>
        ))}
      </div>
    </section>

    <section id="pricing" class="pricing" aria-labelledby="pricing-title">
      <div class="container">
        <div class="section-head centered">
          <h2 id="pricing-title" class="display">Start free. Upgrade when you need more.</h2>
          <p class="section-sub">Personal work is always unlimited. Plans only change collaborative projects.</p>
        </div>
        <div class="plan-grid">
          {plans.map((p) => (
            <div class="plan">
              <h3>{p.name}</h3>
              <p class="plan-price"><span class="display">{p.price}</span> <span class="plan-period">{p.period}</span></p>
              <ul class="plan-list">
                {p.features.map((f) => (
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
              {p.note && <p class="plan-note">{p.note}</p>}
              <a href={APP_URL} class={`btn ${p.primary ? 'primary' : 'ghost'}`}>{p.cta}</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cta" aria-labelledby="cta-title">
      <div class="container cta-inner">
        <h2 id="cta-title" class="display">Your workflow doesn't need more noise.</h2>
        <p class="cta-sub">Open MossTask. See what's next. Get to work.</p>
        <a href={APP_URL} class="btn primary">
          Get started
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <span>&copy; {new Date().getFullYear()} MossTask</span>
      <nav class="footer-links" aria-label="Footer">
        <a href="#features">Features</a>
        <a href="#pricing">Pricing</a>
        <a href={APP_URL}>Sign in</a>
        <a href={APP_URL}>Get started</a>
      </nav>
    </div>
  </footer>
</Layout>

<script is:inline>
  (function () {
    var btn = document.getElementById('menu-toggle');
    var menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', function () {
      var open = menu.classList.toggle('open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
    menu.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () {
        menu.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'Open menu');
      });
    });
  })();
</script>

<style>
  .skip-link {
    position: absolute; left: 12px; top: -48px; z-index: 50;
    background: var(--accent); color: var(--accent-contrast);
    padding: 10px 16px; border-radius: 8px; font-weight: 600; text-decoration: none;
  }
  .skip-link:focus { top: 12px; }

  .nav {
    border-bottom: 1px solid var(--border);
    position: sticky; top: 0;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(10px);
    z-index: 20;
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; padding-block: 14px; gap: 24px; }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 1.15rem; text-decoration: none; color: var(--ink); flex-shrink: 0; }
  .nav-links { display: flex; align-items: center; gap: 22px; flex: 1; justify-content: center; }
  .nav-links a { text-decoration: none; color: var(--ink-2); font-size: 0.92rem; font-weight: 500; }
  .nav-links a:hover { color: var(--ink); }
  .nav-actions { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
  .nav-actions .btn { padding: 9px 16px; font-size: 0.9rem; }

  .menu-toggle {
    display: none; width: 44px; height: 44px; border-radius: 9px;
    border: 1px solid var(--border); background: var(--card); color: var(--ink);
    align-items: center; justify-content: center; cursor: pointer;
  }
  .menu-toggle svg { width: 18px; height: 18px; }
  .mobile-menu { display: none; flex-direction: column; gap: 2px; border-top: 1px solid var(--border); padding: 8px 24px 20px; background: var(--bg); }
  .mobile-menu.open { display: flex; }
  .mobile-menu > a:not(.btn) { padding: 14px 4px; text-decoration: none; color: var(--ink); font-size: 1rem; font-weight: 500; border-bottom: 1px solid var(--border); }
  .mobile-menu-actions { display: flex; gap: 10px; margin-top: 14px; }
  .mobile-menu-actions .btn { flex: 1; }

  .section-head { margin-bottom: 48px; }
  .section-head.centered { text-align: center; max-width: 640px; margin-inline: auto; }
  .section-head h2 { font-size: clamp(1.6rem, 3vw, 2rem); font-weight: 500; margin: 0; letter-spacing: -0.01em; }
  .eyebrow { display: inline-block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-ink); margin-bottom: 12px; }
  .section-sub { color: var(--ink-2); font-size: 1rem; line-height: 1.6; margin: 12px 0 0; }

  .shot {
    width: 100%; height: auto; border-radius: 14px;
    border: 1px solid var(--border); box-shadow: var(--shadow-lg);
    display: block; background: var(--card);
  }

  /* Hero */
  .hero { padding: 72px 0 24px; background: radial-gradient(720px 360px at 82% -12%, var(--accent-soft), transparent); }
  .hero-inner { display: grid; grid-template-columns: 1fr 1.25fr; gap: 56px; align-items: center; padding-bottom: 56px; }
  .hero h1, .section-head h2, .feature-copy h3, .cta h2 { text-wrap: balance; }
  .hero h1 { font-size: clamp(2.4rem, 4.6vw, 3.4rem); line-height: 1.08; font-weight: 500; margin: 8px 0 20px; letter-spacing: -0.01em; }
  .hero-sub { font-size: 1.08rem; color: var(--ink-2); margin: 0 0 28px; max-width: 42ch; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 26px; }
  .hero-points { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px 22px; color: var(--ink-2); font-size: 0.92rem; }
  .hero-points li { display: inline-flex; align-items: center; gap: 7px; }
