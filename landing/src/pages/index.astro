---
import Layout from '../layouts/Layout.astro';

const APP_URL = 'https://aschertype.vercel.app';

const features = [
  {
    title: 'Tasks',
    desc: 'Add tasks in seconds with due dates, priorities, and projects. Nothing slips through the cracks.',
    icon: 'check-square',
  },
  {
    title: 'Projects',
    desc: 'Group related tasks together and keep every project organized in one place.',
    icon: 'folder',
  },
  {
    title: 'Collaboration',
    desc: 'Invite people to a project by email and work together — everyone can view and check off tasks.',
    icon: 'users',
  },
  {
    title: 'Calendar & notes',
    desc: 'Keep dates and quick thoughts right alongside your tasks, synced to your account.',
    icon: 'calendar',
  },
  {
    title: 'Pomodoro timer',
    desc: '25-minute focus blocks with a soft chime, so deep work stays deep.',
    icon: 'timer',
  },
  {
    title: 'Privacy-first',
    desc: 'Use it fully signed out — your data stays on your device. Sign up only if you want sync and sharing.',
    icon: 'lock',
  },
];

const privacyPoints = [
  'Works fully offline, no account needed to start',
  'Local data never leaves your device unless you choose to sync',
  'No trackers, no ad profiles, no data resale',
];

const faqs = [
  {
    q: 'Do I need an account to use Aschertype?',
    a: 'No. Tap "Continue without an account" and everything is stored on your device. Create an account later only if you want sync across devices or want to collaborate on a project.',
  },
  {
    q: 'What happens to my data if I stay signed out?',
    a: 'It stays in local storage on that device only. Nothing is sent anywhere. If you switch devices or clear your browser data, that local copy is what changes — so sync is there if you want the safety net.',
  },
  {
    q: 'Can other people see my tasks?',
    a: 'Only if you invite them to a specific project by email. Everything outside a shared project stays private to your account.',
  },
];

// Minimal inline icon set, stroke-based to match the app's own icon
// style (see auth-screen eye icons in style.css) — no icon package
// or external font needed.
const icons: Record<string, string> = {
  'check-square': '<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>',
  folder: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/>',
  users: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
  timer: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5M9 2h6"/>',
  lock: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
};

function icon(name: string) {
  return icons[name] ?? '';
}
---

<Layout>
  <header class="nav">
    <div class="container nav-inner">
      <a href="/" class="brand">
        <img src="/favicon.png" alt="" width="26" height="26" />
        <span class="display">Aschertype</span>
      </a>

      <nav class="nav-links" aria-label="Primary">
        <a href="#features">Features</a>
        <a href="#privacy">Privacy</a>
        <a href="#faq">FAQ</a>
      </nav>

      <div class="nav-actions">
        <div class="theme-toggle" role="group" aria-label="Theme">
          <button type="button" class="theme-toggle-btn" data-theme="light" aria-label="Light theme">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
          </button>
          <button type="button" class="theme-toggle-btn" data-theme="dark" aria-label="Dark theme">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
          </button>
        </div>
        <a href={APP_URL} class="btn ghost desktop-only">Sign in</a>
        <a href={APP_URL} class="btn primary desktop-only">Get started</a>
        <button type="button" class="menu-toggle" id="menu-toggle" aria-label="Open menu" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
      </div>
    </div>

    <div class="mobile-menu" id="mobile-menu">
      <a href="#features">Features</a>
      <a href="#privacy">Privacy</a>
      <a href="#faq">FAQ</a>
      <div class="mobile-menu-actions">
        <a href={APP_URL} class="btn ghost">Sign in</a>
        <a href={APP_URL} class="btn primary">Get started</a>
      </div>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container hero-inner">
        <div class="hero-copy">
          <h1 class="display">Productivity, all in one place.</h1>
          <p class="hero-sub">
            Tasks, projects, calendar, notes, and a Pomodoro timer — in one
            calm, privacy-first app. No account required to start.
          </p>
          <div class="hero-actions">
            <a href={APP_URL} class="btn primary">Start for free</a>
            <a href="#features" class="btn ghost">See what's inside</a>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="mock-card">
            <div class="mock-row">
              <span class="mock-check done"></span>
              <span class="mock-line long done"></span>
            </div>
            <div class="mock-row">
              <span class="mock-check"></span>
              <span class="mock-line medium"></span>
              <span class="mock-tag">Design</span>
            </div>
            <div class="mock-row">
              <span class="mock-check"></span>
              <span class="mock-line long"></span>
            </div>
            <div class="mock-row">
              <span class="mock-check done"></span>
              <span class="mock-line medium done"></span>
              <span class="mock-tag alt">Marketing</span>
            </div>
            <div class="mock-progress"><span></span></div>
          </div>
        </div>
      </div>
    </section>

    <section id="features" class="features">
      <div class="container">
        <h2 class="display">Everything you need. Nothing you don't.</h2>
        <div class="feature-grid">
          {features.map((f) => (
            <div class="feature-card">
              <div class="feature-icon" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">${icon(f.icon)}</svg>`} />
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="privacy" class="privacy">
      <div class="container privacy-inner">
        <div class="privacy-copy">
          <h2 class="display">Your data, your device — by default.</h2>
          <p>
            Aschertype works fully offline and signed out. Create a free
            account only when you want your tasks, notes, and calendar to
            sync across devices, or to collaborate with someone on a project.
          </p>
        </div>
        <ul class="privacy-list">
          {privacyPoints.map((point) => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="faq" class="faq">
      <div class="container faq-inner">
        <h2 class="display">Questions, answered</h2>
        <div class="faq-list">
          {faqs.map((item) => (
            <details class="faq-item">
              <summary>
                {item.q}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
              </summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="cta">
      <div class="container cta-inner">
        <h2 class="display">Ready to get organized?</h2>
        <a href={APP_URL} class="btn primary">Open Aschertype</a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <span>&copy; {new Date().getFullYear()} Aschertype</span>
      <div class="footer-links">
        <a href="#features">Features</a>
        <a href="#privacy">Privacy</a>
        <a href={APP_URL}>Sign in</a>
      </div>
    </div>
  </footer>
</Layout>

<script is:inline>
  (function () {
    var btn = document.getElementById('menu-toggle');
    var menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', function () {
      var open = menu.classList.toggle('open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    menu.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () {
        menu.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  })();
</script>

<style>
  .nav {
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    z-index: 20;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 14px;
    gap: 24px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 1.15rem;
    text-decoration: none;
    color: var(--ink);
    flex-shrink: 0;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    flex: 1;
    justify-content: center;
  }
  .nav-links a {
    text-decoration: none;
    color: var(--ink-light);
    font-size: 0.92rem;
    font-weight: 500;
  }
  .nav-links a:hover { color: var(--ink); }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .menu-toggle {
    display: none;
    width: 38px; height: 38px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--ink);
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .menu-toggle svg { width: 18px; height: 18px; }

  .mobile-menu {
    display: none;
    flex-direction: column;
    gap: 2px;
    border-top: 1px solid var(--border);
    padding: 8px 24px 20px;
    background: var(--bg);
  }
  .mobile-menu.open { display: flex; }
  .mobile-menu a {
    padding: 12px 4px;
    text-decoration: none;
    color: var(--ink);
    font-size: 0.98rem;
    font-weight: 500;
    border-bottom: 1px solid var(--border);
  }
  .mobile-menu-actions {
    display: flex;
    gap: 10px;
    margin-top: 14px;
  }
  .mobile-menu-actions .btn { flex: 1; }

  .hero {
    padding: 88px 0 96px;
    background: radial-gradient(720px 360px at 82% -12%, var(--accent-soft), transparent);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
  }
  .hero h1 {
    font-size: clamp(2.4rem, 4.6vw, 3.6rem);
    line-height: 1.08;
    font-weight: 500;
    margin: 0 0 20px;
    letter-spacing: -0.01em;
  }
  .hero-sub {
    font-size: 1.1rem;
    color: var(--ink-light);
    margin: 0 0 32px;
    max-width: 46ch;
  }
  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero-visual { display: flex; justify-content: center; }
  .mock-card {
    width: 100%;
    max-width: 360px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 18px;
    box-shadow: var(--shadow-lg);
    padding: 22px 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .mock-row { display: flex; align-items: center; gap: 10px; }
  .mock-check {
    width: 17px; height: 17px; border-radius: 50%;
    border: 1.5px solid var(--border-hover);
    flex-shrink: 0;
  }
  .mock-check.done { background: var(--accent); border-color: var(--accent); }
  .mock-line {
    height: 9px; border-radius: 5px;
    background: var(--task-bg, var(--border));
  }
  .mock-line.done { opacity: 0.45; }
  .mock-line.long { width: 62%; }
  .mock-line.medium { width: 42%; }
  .mock-tag {
    margin-left: auto;
    font-size: 10px;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 9999px;
    background: var(--accent-soft);
    color: var(--accent-ink);
    white-space: nowrap;
  }
  .mock-tag.alt { background: var(--border); color: var(--ink-light); }
  .mock-progress {
    height: 5px;
    border-radius: 9999px;
    background: var(--border);
    overflow: hidden;
    margin-top: 4px;
  }
  .mock-progress span {
    display: block;
    width: 55%;
    height: 100%;
    background: var(--accent);
    border-radius: 9999px;
  }

  .features { padding: 88px 0; }
  .features h2 {
    font-size: 2rem;
    font-weight: 500;
    margin-bottom: 48px;
    max-width: 20ch;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }
  .feature-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 26px;
    box-shadow: var(--shadow-sm);
  }
  .feature-icon {
    width: 42px; height: 42px;
    border-radius: 11px;
    background: var(--accent-soft);
    color: var(--accent-ink);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 16px;
  }
  .feature-icon svg { width: 20px; height: 20px; }
  .feature-card h3 { margin: 0 0 8px; font-size: 1.05rem; color: var(--ink); font-weight: 600; }
  .feature-card p { margin: 0; color: var(--ink-light); font-size: 0.93rem; line-height: 1.55; }

  .privacy {
    padding: 80px 0;
    background: var(--bg-elev);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .privacy-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .privacy-copy h2 { font-size: 1.9rem; font-weight: 500; margin: 0 0 16px; }
  .privacy-copy p { color: var(--ink-light); line-height: 1.65; margin: 0; }
  .privacy-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .privacy-list li { display: flex; align-items: flex-start; gap: 12px; font-size: 0.98rem; }
  .privacy-list svg { width: 19px; height: 19px; color: var(--accent-ink); flex-shrink: 0; margin-top: 2px; }

  .faq { padding: 88px 0; }
  .faq-inner { max-width: 680px; margin: 0 auto; }
  .faq h2 { font-size: 1.9rem; font-weight: 500; margin: 0 0 32px; text-align: center; }
  .faq-list { display: flex; flex-direction: column; gap: 10px; }
  .faq-item {
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--card);
    padding: 4px 20px;
  }
  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 0;
    cursor: pointer;
    font-weight: 500;
    font-size: 0.98rem;
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary svg {
    width: 16px; height: 16px; flex-shrink: 0;
    color: var(--ink-light);
    transition: transform 0.18s ease;
  }
  .faq-item[open] summary svg { transform: rotate(180deg); }
  .faq-item p {
    margin: 0 0 18px;
    color: var(--ink-light);
    font-size: 0.93rem;
    line-height: 1.6;
  }

  .cta { padding: 88px 0; text-align: center; }
  .cta h2 { font-size: 1.9rem; font-weight: 500; margin-bottom: 26px; }

  .site-footer { border-top: 1px solid var(--border); padding-block: 26px; }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--ink-light);
    font-size: 0.88rem;
    flex-wrap: wrap;
    gap: 12px;
  }
  .footer-links { display: flex; gap: 20px; }
  .footer-links a { color: var(--ink-light); text-decoration: none; }
  .footer-links a:hover { color: var(--ink); }

  @media (max-width: 860px) {
    .nav-links { display: none; }
    .desktop-only { display: none; }
    .menu-toggle { display: flex; }

    .hero { padding: 56px 0 64px; }
    .hero-inner { grid-template-columns: 1fr; gap: 40px; text-align: center; }
    .hero-sub { margin-inline: auto; }
    .hero-actions { justify-content: center; }
    .mock-card { max-width: 320px; }

    .privacy-inner { grid-template-columns: 1fr; gap: 32px; text-align: left; }

    .features, .faq, .cta, .privacy { padding-block: 64px; }

    .footer-inner { flex-direction: column; align-items: flex-start; }
  }

  @media (max-width: 480px) {
    .feature-grid { grid-template-columns: 1fr; }
  }
</style>