---
import Layout from '../layouts/Layout.astro';

const APP_URL = 'https://aschertype.vercel.app';

const features = [
  {
    title: 'Tasks',
    desc: 'Add a task in under five seconds. No forms, no required fields, nothing in your way.',
    icon: 'check-square',
  },
  {
    title: 'Projects',
    desc: 'Group work by project. See everything at a glance without opening five tools.',
    icon: 'folder',
  },
  {
    title: 'Collaboration',
    desc: 'Invite someone to a project with their email. No team plan, no seat pricing.',
    icon: 'users',
  },
  {
    title: 'Calendar & reminders',
    desc: 'Add events to any day. Get a notification when its time — no more missed appointments.',
    icon: 'calendar',
  },
  {
    title: 'Notes',
    desc: 'Quick thoughts and longer notes, right next to the tasks they belong to.',
    icon: 'file-text',
  },
  {
    title: 'Pomodoro timer',
    desc: 'Focus in 25-minute blocks. One click to start, a soft chime to rest.',
    icon: 'timer',
  },
];

const principles = [
  {
    title: 'Less, but better',
    desc: 'Every screen has one job. No badges, no upsells, no notifications you didnt ask for.',
    icon: 'feather',
  },
  {
    title: 'Local-first',
    desc: 'Your data lives on your device until you tell it to sync. No hidden telemetry, no ad profiles.',
    icon: 'hard-drive',
  },
  {
    title: 'No lock-in',
    desc: 'Export anytime. Nothing about Aschertype is designed to keep you trapped.',
    icon: 'unlock',
  },
];

const forYou = [
  'You want to start working in seconds, not minutes',
  'Notion, Todoist, or TickTick felt like too much',
  'You want one place for tasks, notes, and focus',
  'You care about where your data lives',
];

const notForYou = [
  'You need Gantt charts, dependencies, or capacity planning',
  'You want AI-generated task suggestions',
  'You need enterprise SSO and audit logs',
  'You enjoy configuring your tools more than using them',
];

const steps = [
  {
    n: '01',
    title: 'Open it',
    desc: 'No account. No email. No signup wall. Open the app and you are already in.',
    icon: 'zap',
  },
  {
    n: '02',
    title: 'Add what matters',
    desc: 'Tasks, projects, dates, notes, focus sessions — everything in one window.',
    icon: 'plus-circle',
  },
  {
    n: '03',
    title: 'Sync when you want',
    desc: 'Create a free account only when you want your work to follow you across devices.',
    icon: 'cloud',
  },
];

const calendarPoints = [
  'Add events to any day — time is optional, all-day works too',
  'Get a notification when an event is starting, so nothing slips',
  'Task due dates appear on the same calendar automatically',
  'Month view designed to stay readable, not crowded',
];

const compareRows = [
  { feature: 'Free to start, no account', aschertype: true, others: 'Mostly false' },
  { feature: 'Works fully offline', aschertype: true, others: 'Rarely' },
  { feature: 'Your data stays on your device by default', aschertype: true, others: 'No' },
  { feature: 'Tasks + calendar + notes + focus in one app', aschertype: true, others: 'Rarely' },
  { feature: 'Event reminders without an account', aschertype: true, others: 'Rarely' },
  { feature: 'Real-time collaboration without a team plan', aschertype: true, others: 'Paid only' },
  { feature: 'Open, portable, no lock-in', aschertype: true, others: 'Proprietary' },
];

const platforms = [
  { name: 'Web', icon: 'globe' },
  { name: 'Windows', icon: 'monitor' },
  { name: 'macOS', icon: 'apple' },
  { name: 'Linux', icon: 'terminal' },
];

const privacyPoints = [
  'Works fully offline, no account needed to start',
  'Local data never leaves your device unless you choose to sync',
  'No trackers, no ad profiles, no data resale',
];

const privacyDonts = [
  'Sell your data',
  'Run ads',
  'Track you across the web',
  'Require an account to use the app',
  'Sync anything until you ask us to',
  'Train AI models on your tasks',
];

const faqs = [
  {
    q: 'Do I need an account to use Aschertype?',
    a: 'No. Tap "Continue without an account" and everything is stored on your device. Create an account later only if you want sync across devices or want to collaborate on a project.',
  },
  {
    q: 'What happens to my data if I stay signed out?',
    a: 'It stays in local storage on that device only. Nothing is sent anywhere. If you switch devices or clear your browser data, that local copy is what changes — so sync is there if you want the safety net.',
  },
  {
    q: 'Can other people see my tasks?',
    a: 'Only if you invite them to a specific project by email. Everything outside a shared project stays private to your account.',
  },
  {
    q: 'Will I get reminded about calendar events?',
    a: 'Yes. Add a time to any event and Aschertype will notify you when its starting. Events without a time still appear on the calendar, they just dont trigger a reminder.',
  },
  {
    q: 'Do task due dates show on the calendar?',
    a: 'Yes. Any task with a due date appears on the calendar automatically — no separate entry needed. That way your tasks and your schedule always agree.',
  },
  {
    q: 'Is Aschertype good for teams?',
    a: 'Its good for small groups working on shared projects. Not a replacement for enterprise project management. If you need Gantt charts, dependencies, and capacity planning, this isnt the tool.',
  },
  {
    q: 'Will Aschertype stay simple?',
    a: 'Yes. Thats the whole point. Every feature we say yes to has to pass one test: does it make the app more useful without making it more complicated? If it fails, we dont ship it.',
  },
  {
    q: 'Is Aschertype really free?',
    a: 'Yes. Use it offline, signed out, forever, for free. An account and sync are also free — they exist for people who want their work to follow them across devices or collaborate with someone.',
  },
  {
    q: 'Which platforms does it run on?',
    a: 'Aschertype runs as a web app in any modern browser, and as a native desktop app on Windows, macOS, and Linux.',
  },
  {
    q: 'Does it work on my phone?',
    a: 'Yes. Open it in your phone browser and add it to your home screen like an app. Sync across devices when you want your tasks to follow you.',
  },
  {
    q: 'What happens if I lose my device?',
    a: 'If you were using it fully signed out, that local copy is gone. If you had an account, sign in on a new device and your tasks, notes, and calendar sync back.',
  },
  {
    q: 'Can I export or move my data?',
    a: 'Yes. Your data lives in a plain, portable format. Nothing is locked in, and you can take it with you any time.',
  },
];

// Minimal inline icon set, stroke-based to match the app's own icon
// style — no icon package or external font needed.
const icons: Record<string, string> = {
  'check-square': '<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>',
  folder: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/>',
  users: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
  timer: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5M9 2h6"/>',
  lock: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  zap: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>',
  'plus-circle': '<circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/>',
  cloud: '<path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/>',
  check: '<path d="M20 6L9 17l-5-5"/>',
  x: '<path d="M18 6L6 18M6 6l12 12"/>',
  globe: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
  monitor: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
  apple: '<path d="M12 20.94c1.5 0 2.75-.34 3.75-1 1.5-1 2.25-2.44 2.25-4.31 0-1.13-.25-2.13-.75-3-1.5-2.5-3.5-4.13-6-4.13-2.5 0-5 1.5-6 4-.25.75-.25 1.5-.25 2.25 0 2.13 1.25 4.5 3 5.63 1.13.75 2.25 1.06 3.5 1.06z"/><path d="M9.5 6.5c0-2 1.5-3.5 3.5-3.5s3.5 1.5 3.5 3.5"/>',
  terminal: '<polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>',
  'arrow-right': '<line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>',
  sparkles: '<path d="M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5L12 3z"/><path d="M19 15l.75 2.25L22 18l-2.25.75L19 21l-.75-2.25L16 18l2.25-.75L19 15z"/><path d="M5 15l.75 2.25L8 18l-2.25.75L5 21l-.75-2.25L2 18l2.25-.75L5 15z"/>',
  feather: '<path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/><line x1="16" y1="8" x2="2" y2="22"/><line x1="17.5" y1="15" x2="9" y2="15"/>',
  'hard-drive': '<line x1="22" y1="12" x2="2" y2="12"/><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/><line x1="6" y1="16" x2="6.01" y2="16"/><line x1="10" y1="16" x2="10.01" y2="16"/>',
  unlock: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/>',
  'file-text': '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>',
  bell: '<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>',
  'message-circle': '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>',
};

function icon(name: string) {
  return icons[name] ?? '';
}
---

<Layout>
  <header class="nav">
    <div class="container nav-inner">
      <a href="/" class="brand">
        <img src="/favicon.png" alt="" width="26" height="26" />
        <span class="display">Aschertype</span>
      </a>

      <nav class="nav-links" aria-label="Primary">
        <a href="#features">Features</a>
        <a href="#calendar">Calendar</a>
        <a href="#how">How it works</a>
        <a href="#who">Who it's for</a>
        <a href="#faq">FAQ</a>
      </nav>

      <div class="nav-actions">
        <div class="theme-toggle" role="group" aria-label="Theme">
          <button type="button" class="theme-toggle-btn" data-theme="light" aria-label="Light theme">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
          </button>
          <button type="button" class="theme-toggle-btn" data-theme="dark" aria-label="Dark theme">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
          </button>
        </div>
        <a href={APP_URL} class="btn ghost desktop-only">Sign in</a>
        <a href={APP_URL} class="btn primary desktop-only">Get started</a>
        <button type="button" class="menu-toggle" id="menu-toggle" aria-label="Open menu" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
      </div>
    </div>

    <div class="mobile-menu" id="mobile-menu">
      <a href="#features">Features</a>
      <a href="#calendar">Calendar</a>
      <a href="#how">How it works</a>
      <a href="#who">Who it's for</a>
      <a href="#faq">FAQ</a>
      <div class="mobile-menu-actions">
        <a href={APP_URL} class="btn ghost">Sign in</a>
        <a href={APP_URL} class="btn primary">Get started</a>
      </div>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container hero-inner">
        <div class="hero-copy">
          <span class="eyebrow">Calm by design</span>
          <h1 class="display">Productivity without the noise.</h1>
          <p class="hero-sub">
            Tasks, projects, calendar, notes, and focus timers — in one calm
            app that gets out of your way. No signup, no clutter, no guilt.
          </p>
          <p class="hero-emphasis">
            Most productivity apps get in your way. Aschertype gets out of it.
          </p>
          <div class="hero-actions">
            <a href={APP_URL} class="btn primary">
              Start for free
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <a href="#features" class="btn ghost">See what's inside</a>
          </div>
          <ul class="hero-points">
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
              No signup wall
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
              Works offline
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
              Free forever
            </li>
          </ul>
        </div>

        <div class="hero-visual">
          <img
            src="/project.png"
            alt="Aschertype showing a project with tasks, due dates, and a completion progress bar."
            width="1600"
            height="900"
            loading="eager"
            decoding="async"
            class="hero-shot"
          />
        </div>
      </div>

      <div class="trust-bar">
        <div class="container trust-inner">
          <span class="trust-label">Built for the way you actually work</span>
          <div class="trust-items">
            <span class="trust-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              Runs in your browser
            </span>
            <span class="trust-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
              Native on desktop
            </span>
            <span class="trust-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              Private by default
            </span>
            <span class="trust-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
              Event reminders
            </span>
          </div>
        </div>
      </div>
    </section>

    <section id="features" class="features">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Features</span>
          <h2 class="display">Built to stay out of your way.</h2>
          <p class="section-sub">
            Everything you need to organize your day. Nothing you'll need to configure.
          </p>
        </div>
        <div class="feature-grid">
          {features.map((f) => (
            <div class="feature-card">
              <div class="feature-icon" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">${icon(f.icon)}</svg>`} />
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="calendar" class="calendar">
      <div class="container calendar-inner">
        <div class="calendar-copy">
          <span class="eyebrow">Calendar</span>
          <h2 class="display">A calendar that reminds you. Not one you forget.</h2>
          <p>
            Add events to any day. Set a time and Aschertype will notify you when
            its starting — no more missed meetings, deadlines, or calls. Leave
            the time blank and it lives as an all-day event, exactly where it
            belongs.
          </p>
          <ul class="calendar-points">
            {calendarPoints.map((point) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="calendar-visual">
          <img
            src="/calendar.png"
            alt="Aschertype calendar month view with events on different days."
            width="1400"
            height="1000"
            loading="lazy"
            decoding="async"
            class="calendar-shot"
          />
        </div>
      </div>

      <div class="container reminder-strip">
        <div class="reminder-card">
          <div class="reminder-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          </div>
          <div class="reminder-copy">
            <h3>Reminders that actually arrive</h3>
            <p>When an event has a time, Aschertype sends a notification so you dont miss it. Works on desktop and in the browser.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="principles" class="principles">
      <div class="container">
        <div class="section-head centered">
          <span class="eyebrow">Principles</span>
          <h2 class="display">Why we built it this way.</h2>
        </div>
        <div class="principle-grid">
          {principles.map((p) => (
            <div class="principle-card">
              <div class="principle-icon" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">${icon(p.icon)}</svg>`} />
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="how" class="how">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">How it works</span>
          <h2 class="display">Three steps. That's it.</h2>
        </div>
        <div class="steps">
          {steps.map((s) => (
            <div class="step">
              <div class="step-num display">{s.n}</div>
              <div class="step-icon" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">${icon(s.icon)}</svg>`} />
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="collab" class="collab">
      <div class="container collab-inner">
        <div class="collab-copy">
          <span class="eyebrow">Group projects</span>
          <h2 class="display">Collaboration, without the chaos.</h2>
          <p>
            Invite someone by email. They see the project, they can check things off,
            everyone stays in sync. No Slack. No @-mentions. No notifications you
            didn't ask for. Just the list, and the people working on it.
          </p>
          <ul class="collab-points">
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
              Invite by email in one click
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
              Everyone sees the same list, live
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
              Permission to add, rename, or remove — your call
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
              Free. No team plan, no seat pricing
            </li>
          </ul>
        </div>
        <div class="collab-visual">
          <img
            src="/project.png"
            alt="A shared Aschertype project viewed by multiple people."
            width="1200"
            height="700"
            loading="lazy"
            decoding="async"
            class="collab-shot"
          />
        </div>
      </div>
    </section>

    <section id="who" class="who">
      <div class="container">
        <div class="section-head centered">
          <span class="eyebrow">Fit</span>
          <h2 class="display">Who it's for. And who it isn't.</h2>
          <p class="section-sub">
            Being honest about this saves us both time.
          </p>
        </div>

        <div class="who-grid">
          <div class="who-card for">
            <div class="who-head">
              <span class="who-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
              <h3>Aschertype is for you if</h3>
            </div>
            <ul>
              {forYou.map((item) => (
                <li>
