{
  "name": "aschertype",
  "version": "1.0.0",
  "description": "Aschertype - tasks, calendar, notes and focus timer",
  "author": {
    "name": "Aschertype",
    "email": "aschertype@gmail.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "mkdir -p \"${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}/aschertype-electron-tmp\" && TMPDIR=\"${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}/aschertype-electron-tmp\" electron .",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:run": "npx cap run android",
    "android:build": "cd android && ./gradlew bundleRelease",
    "dist": "electron-builder",
    "pack": "electron-builder --linux dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitest/coverage-v8": "^2.1.9",
    "electron": "^44.4.5",
    "electron-builder": "^24.13.3",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@supabase/supabase-js": "^2.45.0"
  },
  "build": {
    "appId": "com.aschertype.app",
    "productName": "Aschertype",
    "icon": "src/favicon.png",
    "compression": "maximum",
    "afterPack": "build/afterPack.js",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "db.js",
      "utils.js",
      "style.css",
      "src/**/*",
      "vendor/**/*",
      "!landing/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
